# Web environment variables (example values only - never put real secrets here).
# Copy to .env.local for local development; .env files are ignored by Git.

# Base URL of the Express API, used from the server only.
# Deliberately NOT prefixed with NEXT_PUBLIC_: the browser must never call the
# API directly, and this value must not reach client JavaScript.
# Must be an absolute http:// or https:// URL.
# Outside production it defaults to http://127.0.0.1:4000 when unset; in
# production it is required and the server refuses to start a request without it.
API_BASE_URL=http://127.0.0.1:4000

# The origin (and, if the deployment uses one, the path prefix) that
# admin-uploaded media is served from. Read only by next.config.ts, at
# build/dev-start time, to allow and optimize that one remote origin with
# next/image.
#
# One origin for every kind of admin-uploaded image, not one per owner. Room
# type images and journey images are stored in the same bucket under the same
# `media/<uuid>.webp` keys, so the single remote pattern derived from this
# value — `<this base>/media/**` — already covers both. Which record an image
# belongs to is a database fact, never part of the host or the key.
#
# Deliberately NOT prefixed with NEXT_PUBLIC_: the actual image URL a browser
# fetches comes from the API's own response for each image, never from this
# variable, so nothing here needs to reach client JavaScript. It is also
# deliberately provider-neutral - this app never names Cloudflare, R2 or any
# other storage vendor.
#
# Optional. Left unset, the build still succeeds; next/image simply has no
# remote origin allowed yet; the placeholder below is an EXAMPLE VALUE ONLY,
# never a real one, and no real address belongs in this repository.
# Must be an absolute https:// URL with no username/password, query string or
# fragment.
MEDIA_PUBLIC_BASE_URL=https://media.example.test
