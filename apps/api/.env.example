# API environment variables (example values only - never put real secrets here).
# The API reads these from the process environment; .env files are not loaded automatically.

# HTTP port the API listens on. Defaults to 4000 when unset.
PORT=4000

# MySQL 8 connection string.
DATABASE_URL=mysql://hotel:hotel@127.0.0.1:3307/hotel_reservation

# Deployment mode. Deliberately left unset here rather than copied: any
# DEPLOYED environment MUST run with NODE_ENV=production, because the admin
# session cookie's Secure attribute is derived from it. A deployment that
# leaves it unset issues session cookies without Secure, so the session token
# can travel over plain HTTP. Locally it must stay unset — a Secure cookie
# would not survive http://localhost.
#   NODE_ENV=production

# How long an admin session stays valid, in whole hours. Optional: when the
# variable is absent entirely it defaults to 12. If it is present it must be a
# positive whole number — a blank or malformed value is rejected rather than
# quietly falling back, so a typo cannot silently change how long a staff
# session lives. The same value sets both the stored expiry and the cookie's
# Max-Age.
ADMIN_SESSION_TTL_HOURS=12

# --- Local media storage (no R2 / S3 needed) -------------------------------
# Set MEDIA_DRIVER=local to store uploads on this server's disk instead of R2.
# The API serves them at /media/<uuid>.webp and the web app proxies /media/*
# (set MEDIA_DRIVER=local and API_BASE_URL in apps/web too). Then set
# R2_PUBLIC_BASE_URL (below) and the web MEDIA_PUBLIC_BASE_URL to the site's
# own https origin, e.g. https://yourdomain.com. The R2_* credentials are not
# needed. Keep MEDIA_LOCAL_DIR outside the folder replaced on each deploy.
# MEDIA_DRIVER=local
# MEDIA_LOCAL_DIR=uploads

# --- Media object storage (Cloudflare R2) ---------------------------------
# Read lazily, only when an image is actually stored: the API starts, serves
# every other endpoint and runs its whole test suite with all five unset.
# R2 speaks the S3 protocol, so these are ordinary S3 credentials.

# The bucket's S3 API endpoint. Must be an absolute https URL with no
# username, password, query string or fragment. The host is not checked
# against Cloudflare, so an S3-compatible endpoint works here too.
R2_ENDPOINT=https://example-account-id.r2.cloudflarestorage.com

# An R2 Account API token with Object Read & Write, scoped to this bucket
# alone. Never the account's global key, and never a token that can list or
# administer buckets - the API only ever puts and deletes single objects.
R2_ACCESS_KEY_ID=example-access-key-id
R2_SECRET_ACCESS_KEY=example-secret-access-key

# The bucket these objects live in. Separate buckets per environment; a
# deployment never writes into another one's.
R2_BUCKET=three-pyramids-media-dev

# Where stored media is served to guests from, without a trailing slash.
# Separate from the four above and required only when public delivery is:
# uploads, deletes and the test suite all work with this unset. A production
# deployment should point this at a custom domain bound to the bucket rather
# than at an r2.dev address, which Cloudflare rate-limits and does not intend
# for production traffic.
R2_PUBLIC_BASE_URL=https://media.example.com

# --- Reservation notification emails ---------------------------------------
# Off unless explicitly switched on. While off, nothing below is read or
# required, no dispatcher runs, and no outbox row is ever claimed.
NOTIFICATIONS_ENABLED=false

# Required only when NOTIFICATIONS_ENABLED is true. The API key is a
# credential and is never logged, quoted in an error, or trimmed.
RESEND_API_KEY=
# The sender guests and the hotel see. Frozen onto each row at its first claim.
NOTIFICATIONS_FROM_ADDRESS=Three Pyramids Boutique Hotel <stay@example.com>
# Where hotel-facing notifications go. Guest notifications use the guest's own
# address, snapshotted when the booking was made.
NOTIFICATIONS_HOTEL_RECIPIENT=frontdesk@example.com

# Optional, with the defaults shown. The claim lease is NOT configurable: it is
# derived from batch size x request timeout, because the batch is sent
# sequentially and the lease has to cover the whole window.
NOTIFICATIONS_REQUEST_TIMEOUT_MS=10000
NOTIFICATIONS_DISPATCH_INTERVAL_MS=30000
NOTIFICATIONS_MAX_ATTEMPTS=8
NOTIFICATIONS_BATCH_SIZE=5
